{
  "name": "ansible-interactive",
  "version": "2.0.0-beta.1",
  "description": "Interactive prompt for building and running ansible-playbook commands",
  "license": "MIT",
  "repository": "github:glhd/ansible-interactive",
  "type": "module",
  "bin": {
    "ansible-interactive": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "build:binaries": "bun scripts/build-binaries.ts",
    "package:release": "sh scripts/package-release.sh"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
